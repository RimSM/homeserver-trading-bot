# ─────────────────────────────────────────────
# trading-bot 환경변수 템플릿
# 실제 값은 .env 에 넣는다 (.env는 .gitignore로 커밋 제외).
# 🔴 이 파일(.env.example)엔 절대 실제 키를 넣지 말 것 — 여긴 커밋됨.
# ─────────────────────────────────────────────

# 실행 환경
TBOT_ENV=stage        # stage(돈X, mock/paper) | prod(실제 돈, 토스 real)
TBOT_MODE=paper       # backtest | paper | live

# ── KIS 한국투자증권 (시세 소스 / feed) ──
KIS_ENV=paper                 # paper(모의) | real(실전) — 키 쌍이 다름
KIS_APP_KEY=                  # 발급받은 App Key
KIS_APP_SECRET=               # 발급받은 App Secret
KIS_ACCOUNT_NO=               # 계좌번호 앞 8자리
KIS_ACCOUNT_PROD_CODE=        # 계좌 상품코드 뒤 2자리 (예: 01)
KIS_SYMBOL=TQQQ               # 첫 수집 종목
KIS_TR_KEY=                   # 실제 SUBSCRIBE SUCCESS를 확인한 KIS 구독키

# ── MinIO (Tick Landing/Bronze 파일 저장) ──
MINIO_ENDPOINT_URL=            # 예: https://s3.rimsm.com
MINIO_ACCESS_KEY=              # trading-bot 전용 access key
MINIO_SECRET_KEY=              # trading-bot 전용 secret key
MINIO_BUCKET=trading-bot       # private bucket 이름
MINIO_REGION=us-east-1         # MinIO 기본 region

# Landing micro-batch. 기본값: 50,000건 또는 5분 중 먼저 도달한 기준으로 flush.
TBOT_LANDING_MAX_RECORDS=50000
TBOT_LANDING_FLUSH_SECONDS=300

# ── 토스증권 (주문 실행 / broker) ──
TOSS_CLIENT_ID=               # Open API client_id
TOSS_CLIENT_SECRET=           # Open API client_secret
TOSS_ACCOUNT=                 # X-Tossinvest-Account 헤더용 계좌 식별자
